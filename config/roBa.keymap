#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <4>;
    // レイヤー4がアクティブな時のみカーソル操作を通す設定

    scroll-layers = <5>;   /* レイヤー5 (SCROLL) にいる時だけスクロールを許可 */
    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 10>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 11>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 7 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_mac {
            bindings = <
&kp Q               &kp W             &kp E         &kp R         &kp T                                      &kp Y  &kp U  &kp I      &kp O    &lt 5 P
&mt LEFT_CONTROL A  &kp S             &kp D         &kp F         &kp G        &trans         &kp MINUS      &kp H  &kp J  &kp K      &kp L    &lt 4 ENTER
&mt LEFT_SHIFT Z    &kp X             &kp C         &kp V         &kp B        &kp SQT        &kp SEMICOLON  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH
&mo 1               &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &lt 1 SPACE  &lt 2 TAB      &lt 2 TAB      &mo 3                             &mo 6
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        layer1 {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH              &kp DOLLAR            &kp PERCENT                                           &kp CARET  &kp AMPERSAND  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH              &kp DOLLAR            &kp PERCENT               &trans       &kp MINUS      &kp EQUAL  &kp BACKSLASH  &kp GRAVE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&trans           &trans       &kp LG(LS(NUMBER_3))  &kp LG(LS(NUMBER_4))  &kp LG(LS(LC(NUMBER_4)))  &kp SQT      &kp SEMICOLON  &kp PLUS   &kp PIPE       &kp TILDE  &kp LEFT_BRACE        &kp RIGHT_BRACE
&trans           &trans       &trans                &trans                &trans                    &trans       &trans         &trans                                                     &kp ESC
            >;
        };

        NUM {
            bindings = <
&kp NUMBER_1       &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                              &kp NUMBER_6  &kp N7  &kp N8        &kp N9        &kp N0
&kp NUMBER_1       &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &none        &none    &kp NUMBER_6  &kp N7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&mt LEFT_SHIFT F1  &kp F2        &kp F3        &kp F4        &kp F5        &kp F11      &kp F12  &kp F6        &kp F7  &kp F8        &kp F9        &kp F10
&trans             &trans        &trans        &trans        &trans        &trans       &trans   &trans                                            &none
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &none                                           &none          &kp LS(LC(TAB))     &kp UP_ARROW      &kp LC(TAB)      &kp LA(LEFT)
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END       &none              &kp PAGE_UP    &kp BACKSPACE  &kp LEFT_ARROW      &kp DOWN_ARROW    &kp RIGHT_ARROW  &kp LA(RIGHT)
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &none           &kp LG(LS(RIGHT_ARROW))  &kp LA(LEFT)  &kp LA(RIGHT)      &kp PAGE_DOWN  &none          &kp LC(LEFT_ARROW)  &kp LC(UP_ARROW)  &kp LC(RIGHT)    &none
&none           &none                   &none           &none                    &none         &none              &none          &none                                                                 &none
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans     &trans     &trans     &trans                             &trans  &kp LA(RIGHT)       &trans    &trans    &trans
&trans  &trans     &trans     &trans     &trans    &trans        &kp LC(C)  &trans  &kp LA(LEFT_ARROW)  &mkp MB1  &mkp MB2  &trans
&trans  &kp LG(X)  &kp LG(C)  &kp LG(V)  &trans    &trans        &kp LC(V)  &trans  &trans              &mkp MB3  &trans    &trans
&trans  &trans     &trans     &mkp MB4   &mkp MB5  &mkp MB3      &trans     &trans                                          &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans          &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &bt BT_CLR_ALL  &bt BT_CLR
&trans  &trans        &trans        &to 0         &to 7   &trans      &trans       &trans                                                    &trans
            >;
        };

        default_layer_win {
            bindings = <
&kp Q             &kp W         &kp E         &kp R      &kp T                                                 &kp Y      &kp U  &kp I      &kp O    &lt_to_layer_0 5 P
&mt LCTRL A       &kp S         &kp D         &kp F      &kp G        &kp LS(LG(S))      &kp C_AC_SCROLL_UP    &kp H      &kp J  &kp K      &kp L    &lt 4 ENTER
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V      &kp B        &kp C_MUTE         &kp C_AC_SCROLL_DOWN  &kp N      &kp M  &kp COMMA  &kp DOT  &kp SLASH
&mo 1             &kp LEFT_ALT  &kp LEFT_WIN  &kp LCTRL  &lt 1 SPACE  &mo 2              &kp TAB               &lt 3 RET                             &lt 6 DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOLUME_UP>;
        };
    };
};
